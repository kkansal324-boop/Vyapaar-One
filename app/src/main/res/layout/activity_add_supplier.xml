<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Supplier"
            android:textAlignment="center"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginTop="40dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your business suppliers professionally"
            android:textAlignment="center"
            android:textSize="15sp"
            android:textColor="#000"
            android:layout_marginBottom="25dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supplier Information"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etSupplierName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Supplier Name *"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etCompanyName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Company Name"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Mobile Number"
                android:inputType="phone"
                android:maxLength="10"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etGST"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="GST Number"
                android:inputType="textCapCharacters"
                android:padding="12dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="top"
                android:hint="Address"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="City"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etState"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="State"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etPincode"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="PIN Code"
                android:inputType="number"
                android:maxLength="6"
                android:padding="12dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financial Information"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etOpeningBalance"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Opening Balance"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <Spinner
                android:id="@+id/spBalanceType"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:hint="Notes"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnSaveSupplier"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="SAVE SUPPLIER"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <Button
                android:id="@+id/btnDeleteSupplier"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:text="Delete Supplier"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="17sp"
                android:backgroundTint="#D32F2F"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>