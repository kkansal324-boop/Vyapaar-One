<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="40dp">

        <!-- Top Bar -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Product Details"
                android:textStyle="bold"
                android:textSize="30sp"
                android:textColor="@android:color/black" />

        </RelativeLayout>

        <!-- Product Icon -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"
            android:text="📦"
            android:textSize="72sp" />

        <!-- Product Information Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Information"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:textSize="23sp"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:id="@+id/txtProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtMinStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimum Stock"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtMaxStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum Stock"
                    android:textSize="20sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/txtStockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Status"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Actions Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actions"
            android:textStyle="bold"
            android:textSize="23sp"
            android:textColor="#1565C0"
            android:layout_marginBottom="18dp"/>

        <!-- Edit -->

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#1976D2"
            android:text="✏ Edit Product"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"/>

        <!-- Increase -->

        <Button
            android:id="@+id/btnIncrease"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#2E7D32"
            android:text="➕ Increase Stock"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"/>

        <!-- Reduce -->

        <Button
            android:id="@+id/btnDecrease"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#F57C00"
            android:text="➖ Reduce Stock"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"/>

        <!-- Delete -->

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#D32F2F"
            android:text="🗑 Delete Product"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"/>

    </LinearLayout>

</ScrollView>