<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Purchase Return"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="25dp"/>

        <Spinner
            android:id="@+id/spPurchase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etReturnQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Return Quantity"
            android:inputType="numberDecimal"/>

        <EditText
            android:id="@+id/etReturnAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Return Amount"
            android:inputType="numberDecimal"/>

        <EditText
            android:id="@+id/etReturnDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:focusable="false"
            android:hint="Return Date"/>

        <EditText
            android:id="@+id/etReason"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="15dp"
            android:gravity="top"
            android:hint="Reason"
            android:inputType="textMultiLine"/>

        <Button
            android:id="@+id/btnSaveReturn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Save Purchase Return"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</ScrollView>